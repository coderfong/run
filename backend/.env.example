# Local development. Production values are injected by the host (Fly/Render).

# "development" or "production". Production refuses to boot with the dev
# JWT secret or CORS_ORIGINS=*.
ENV=development

# Required.
DATABASE_URL=postgresql://run:run@localhost:5432/run

# JWT — generate with `openssl rand -hex 32`.
# MUST be set in production (the server fails loudly otherwise).
JWT_SECRET=dev-only-change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
# Clients silently call POST /auth/refresh when this close to expiry.
JWT_REFRESH_WINDOW_DAYS=7

# CORS — comma-separated list of origins. "*" is dev-only.
CORS_ORIGINS=*

# Crash telemetry — leave empty to disable Sentry entirely.
SENTRY_DSN=

# Reported by GET /version.
APP_VERSION=1.0.0

# Rate limits (slowapi syntax).
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SUBMIT_PATH=60/minute
RATE_LIMIT_END_RUN=6/minute
RATE_LIMIT_DEFAULT=120/minute

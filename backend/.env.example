# Local development. Production values are injected by the host (Fly/Render).

# "development" or "production". Production refuses to boot with the dev
# JWT secret or CORS_ORIGINS=*.
ENV=development

# Required.
DATABASE_URL=postgresql://run:run@localhost:5432/run

# JWT — generate with `openssl rand -hex 32`.
# MUST be set in production (the server fails loudly otherwise).
JWT_SECRET=dev-only-change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
# Clients silently call POST /auth/refresh when this close to expiry.
JWT_REFRESH_WINDOW_DAYS=7

# CORS — comma-separated list of origins. "*" is dev-only.
CORS_ORIGINS=*

# Crash telemetry — leave empty to disable Sentry entirely.
SENTRY_DSN=

# Reported by GET /version.
APP_VERSION=1.0.0

# Rate limits (slowapi syntax).
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SUBMIT_PATH=60/minute
RATE_LIMIT_END_RUN=6/minute
RATE_LIMIT_DEFAULT=120/minute
# Recovery endpoints send mail to an address the caller names, so they are held
# well below the others.
RATE_LIMIT_RECOVERY=5/hour

# --- Account recovery (forgot password) --------------------------------------
# MAIL_BACKEND: "log" (development — the code is written to the server log and
# no mail is sent), "resend" or "smtp". Anything else, or "log" in production,
# means /auth/forgot returns 501 and the app tells runners that reset is not
# available. Nothing else in the app depends on mail.
MAIL_BACKEND=log
MAIL_FROM=PASER <recovery@paser.app>

# Resend (https://resend.com): an API key, and a sender domain verified there.
RESEND_API_KEY=

# ...or any SMTP host. STARTTLS is required unless MAIL_SMTP_SSL=true; a host
# that cannot negotiate it is refused rather than used in the clear.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_SSL=false

# The code and the ticket it buys.
RECOVERY_CODE_TTL_MINUTES=15
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_TICKET_TTL_MINUTES=10

# Local development. Production values are injected by the host (Fly/Render).

# Required.
DATABASE_URL=postgresql://run:run@localhost:5432/run

# JWT — generate with `openssl rand -hex 32`.
# MUST be set in production.
JWT_SECRET=dev-only-change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# CORS — comma-separated list, or "*" for any origin.
CORS_ORIGINS=*

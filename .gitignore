# Logs
*.log
*.log.err

# Local Claude/editor state
.claude/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Env / secrets
.env
.env.local
.env.*.local

# Node / Expo
node_modules/
.expo/
# eas update export output (regenerated every publish)
frontend/dist/

# OS
.DS_Store
Thumbs.db

# Editor local history
.history/
backend/reset_db.py

# Raw generation sources / design mockups — working files, not app assets.
# The shipped art lives in frontend/assets/.
new/
here/

# Asset-pipeline intermediates. The scripts are tracked; what they chew
# through on the way (harvested crops, QA montages, generated snippets) is
# tens of MB of scratch and gets regenerated by re-running them.
frontend/scripts/out*/
frontend/scripts/qa*/
frontend/scripts/items*.json
frontend/scripts/reps*.json
frontend/scripts/installed*.json
frontend/scripts/catalog_snippet*.js
frontend/scripts/premium*.txt

# The outfit art as it came out of the renders, before scripts/strip-body-parts.py
# took the model's arms and legs out of it. 57 MB of byte-identical duplicates of
# what ships, so it stays out of the repo — but DO NOT DELETE IT locally: the
# strip pass reads from here, and re-running it against its own output would
# eat the garment.
frontend/assets/character/_src/

# The rank tier illustrations at generation size (1672px truecolour, 15 MB).
# `scripts/install-rank-art.py` reads from here and writes the capped, indexed
# copies that ship under assets/art/rank/ — same arrangement as the line above.
frontend/assets/art/rank/_src/

# Fit Studio working files (backups of the catalogue, trashed art, edit logs)
frontend/scripts/fit-studio/backups/
frontend/scripts/fit-studio/deleted-art/
frontend/scripts/fit-studio/fit-overrides*.json

# More of the same category the block above describes, caught when the tree was
# first committed wholesale: snapshots taken before a destructive art pass and
# the contact sheets used to eyeball the result. ~17 MB between them, all of it
# reproducible by re-running the script that made it, none of it referenced by
# the app. `qa*/` above does not match `hair-qa/`, which is how these survived.
frontend/scripts/backups/
frontend/scripts/hair-qa/
frontend/scripts/headwear4-prerepair/

# Raw harvest downloads that landed in the app root instead of the pipeline's
# working directory: 678 of them, named `<item>-<HASH>.png` the way the source
# site serves them. Nothing references these names, and every one of them is
# already installed under assets/character/<slot>/<item>.png by the install
# pass — they are the BEFORE, kept by accident.
#
# The shipped art is the installed copy. If a harvest ever needs re-running,
# it reads from wherever it was told to download to, never from here.
frontend/*.png
